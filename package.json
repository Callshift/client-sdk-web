{
  "name": "@callshift/web",
  "version": "0.1.0",
  "description": "Join a Callshift web call from the browser.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Callshift/client-sdk-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Callshift/client-sdk-web.git"
  },
  "bugs": {
    "url": "https://github.com/Callshift/client-sdk-web/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:checked": "pnpm build && node scripts/check-pack.mjs",
    "example": "pnpm build && node example/server.mjs"
  },
  "dependencies": {
    "livekit-client": "^2.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
