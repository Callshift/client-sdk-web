{
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["jest", "node"],
    "paths": { "@callshift/web": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "example/**/*.ts"]
}
